# Credentials for the capture daemon.
#
# Cron runs with almost no environment, so scripts/watchdog.sh sources this
# file before relaunching. Copy to .env and fill in; .env is gitignored.
#
# The key id is a UUID. It is not a secret on its own, but the private key it
# names very much is: keep that file mode 600.
KALSHI_AUTH__KEY_ID=
KALSHI_AUTH__PRIVATE_KEY_PATH=$HOME/.kalshi/kalshi-private-key.pem

# Which environment the watchdog restarts into. "prod" adds the
# --i-understand-this-is-production acknowledgement flag automatically.
KALSHI_CAPTURE_ENV=prod
