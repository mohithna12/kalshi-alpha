# --- Secrets. Never commit. ---
*.pem
*.key
*.p8
*.pkcs8
.env
.env.*
!.env.example
secrets/

# --- Captured data. Append-only, large, irreplaceable; lives outside git. ---
data/

# --- Rust build artifacts ---
/target/
**/*.rs.bk

# --- Local operational state ---
# Runtime artifacts of a capture run. These churn on every start and belong to
# the machine, not the repository. capture.log was tracked once by accident --
# it was clean (INFO-level operational output only, no credentials), but it has
# no business in version control.
*.heartbeat
heartbeat
logs/
*.log
*.pid
.watchdog.log

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
